      "parameters": {
        "jsCode": "// Edit BRAND to match your voice. Reviews come from the sheet above\n// (columns: review, rating, author, date, verified, consent).\nconst BRAND = {\n  \"name\": \"Your Brand\",\n  \"tone\": \"warm\",\n  \"emoji\": true,\n  \"hashtags\": [\n    \"#YourBrand\",\n    \"#CustomerLove\"\n  ],\n  \"cta\": \"Shop the bestsellers, link in bio.\",\n  \"banned_words\": [],\n  \"min_rating\": 4,\n  \"max_posts\": 10\n};\nreturn [{ json: {\n  reviews: $input.all().map(i => i.json),\n  brand: BRAND,\n  platforms: ['instagram', 'linkedin', 'x'],\n} }];"
      },
      "name": "Bundle reviews + brand",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
